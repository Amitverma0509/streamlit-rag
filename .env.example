# Groq API key - get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Embedding model (same all-MiniLM-L6-v2; "Xenova/" is auto-mapped to "sentence-transformers/")
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Chunking config
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval config
TOP_K=5
MIN_SCORE=0.2

# Optional: reuse the Node project's data (uploads + vector_store)
# DATA_DIR=../RAG/backend/data
